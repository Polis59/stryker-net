<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stryker.CLI</RootNamespace>
    <AssemblyName>Stryker.CLI</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-stryker</ToolCommandName>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>dotnet-stryker</PackageId>
    <Authors>Richard Werkman, Rouke Broersma</Authors>
    <Product>Mutation Testing</Product>
    <Description>The Stryker.NET CLI tool. Install this tool to run stryker from the commandline.</Description>
    <PackageProjectUrl>https://stryker-mutator.io/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>stryker-80x80.png</PackageIcon>
    <RepositoryUrl>https://github.com/stryker-mutator/stryker-net</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Stryker.Core\Stryker.Core\Stryker.Core.csproj" />
    <!-- Built for its output only: the MTP runner spawns the collectible isolation broker from
         an `isolation-host` folder beside its own assembly (see CollectibleTestIsolationClient),
         so the host must not merge into the CLI's dependency closure. -->
    <ProjectReference Include="..\..\Stryker.TestIsolationHost\Stryker.TestIsolationHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyIsolationHostPayload" AfterTargets="Build">
    <ItemGroup>
      <IsolationHostPayload Include="..\..\Stryker.TestIsolationHost\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(IsolationHostPayload)"
      DestinationFiles="@(IsolationHostPayload->'$(OutDir)isolation-host\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\..\docs\images\stryker-80x80.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
